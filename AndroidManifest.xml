<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.trucker.money"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <application
        android:label="Таптар"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity android:name=".MainActivity"
            android:exported="true"
            android:label="Таптар">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AddActivity" android:label="Новая запись" android:exported="false" />
        <activity android:name=".HistoryActivity" android:label="История" android:exported="false" />
        <activity android:name=".StatsActivity" android:label="Статистика" android:exported="false" />
        <activity android:name=".SettingsActivity" android:label="Настройки" android:exported="false" />
    </application>
</manifest>
